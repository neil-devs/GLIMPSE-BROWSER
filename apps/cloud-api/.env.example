# ============================================================================
# Glimpse Browser Cloud API — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# ── Supabase ────────────────────────────────────────────────────────────────
# Get these from your Supabase project dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-public-key-here

# ── JWT Secrets ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use DIFFERENT secrets for access and refresh tokens.
JWT_SECRET=your-access-token-secret-min-64-chars
JWT_REFRESH_SECRET=your-refresh-token-secret-min-64-chars

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of additional allowed origins.
# In production, app://glimpse is always allowed.
# In development, localhost is automatically allowed.
CORS_ORIGIN=

# ── Rate Limiting ───────────────────────────────────────────────────────────
# Override default rate limits (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
