{
  "name": "@glimpse/cloud-api",
  "version": "1.0.0",
  "description": "Glimpse Browser Cloud API — authentication, sync, telemetry, and ML model serving",
  "main": "src/index.js",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development node --watch src/index.js",
    "start": "NODE_ENV=production node src/index.js",
    "test": "jest --coverage",
    "lint": "eslint src/",
    "db:seed": "psql $DATABASE_URL -f src/db/seeds/dev-seed.sql",
    "db:migrate": "for f in src/db/migrations/*.sql; do psql $DATABASE_URL -f $f; done",
    "db:reset": "psql $DATABASE_URL -f src/db/schema.sql && npm run db:seed",
    "job:retrain": "node -e \"require('./src/jobs/retrain-model.job').runRetraining()\"",
    "job:cleanup": "node -e \"require('./src/jobs/cleanup-telemetry.job').runCleanup()\""
  },
  "dependencies": {
    "@glimpse/shared": "*",
    "@supabase/supabase-js": "2.45.4",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.0",
    "express-rate-limit": "7.4.0",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "ml-decisiontree": "1.0.0",
    "morgan": "1.10.0",
    "node-cron": "3.0.3",
    "uuid": "10.0.0",
    "winston": "3.14.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "supertest": "7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
