{
  "name": "@glimpse/cloud-api",
  "version": "1.0.0",
  "description": "Glimpse Browser Cloud API — authentication, sync, telemetry, and ML model serving",
  "main": "src/index.js",
  "private": true,
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "jest --coverage",
    "lint": "eslint src/",
    "job:retrain": "node -e \"require('./src/jobs/retrain-model.job').runRetraining()\"",
    "job:cleanup": "node -e \"require('./src/jobs/cleanup-telemetry.job').runCleanup()\""
  },
  "dependencies": {
    "@glimpse/shared": "*",
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "7.4.0",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "ml-cart": "^2.0.0",
    "morgan": "^1.12.1",
    "node-cron": "^4.6.0",
    "uuid": "^14.0.2",
    "winston": "3.14.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "supertest": "7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
