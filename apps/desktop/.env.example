# ============================================================================
# Glimpse Browser Desktop — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# ============================================================================

# ── App Configuration ───────────────────────────────────────────────────────
NODE_ENV=development
APP_VERSION=1.0.0

# ── Cloud API ───────────────────────────────────────────────────────────────
# URL of the Glimpse Cloud API server.
# Leave empty to run in fully offline mode.
CLOUD_API_URL=http://localhost:3001/api/v1

# ── Telemetry ───────────────────────────────────────────────────────────────
# Set to 'false' to disable sending telemetry to the cloud API.
TELEMETRY_ENABLED=true
