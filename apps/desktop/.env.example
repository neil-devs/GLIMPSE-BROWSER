# ============================================================================
# Glimpse Browser Desktop — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# ============================================================================

# ── App Configuration ───────────────────────────────────────────────────────
NODE_ENV=development
APP_VERSION=1.0.0

# ── Cloud API ───────────────────────────────────────────────────────────────
# URL of the Glimpse Cloud API server.
# Leave empty to run in fully offline mode.
CLOUD_API_URL=http://localhost:3001/api/v1

# ── Telemetry ───────────────────────────────────────────────────────────────
# Set to 'false' to disable sending telemetry to the cloud API.
TELEMETRY_ENABLED=true
# Set to '1' to log payloads to console instead of sending
GLIMPSE_TELEMETRY_DEBUG=0

# ── Benchmarking ───────────────────────────────────────────────────────────
# Set to '1' when running prefetch benchmark suites (disables telemetry)
GLIMPSE_BENCH=0

# ── Phase 11 Prefetch Flags ────────────────────────────────────────────────
# Eagerly preconnect (DNS + TCP + TLS) to all visible search result domains
PREFETCH_PRECONNECT_ALL=true
# Bump priority / ensure pooled when user hovers a result link for >80ms
PREFETCH_HOVER_BOOST=true
# Max concurrent pool loads in flight (1, 2, or 3) to prevent network congestion
PREFETCH_STAGED_CONCURRENCY=2
# Pool swap readiness threshold: 'usable' (interactive DOM) or 'load' (window load event)
PREFETCH_READY_MODE=usable
# Preload pool size override (3 = conservative, 6 = balanced, 12 = aggressive)
PREFETCH_POOL_SIZE=6
# Throttle background timers in pooled views after ready state to minimize idle CPU
PREFETCH_THROTTLE_AFTER_READY=true
