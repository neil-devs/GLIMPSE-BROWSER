{
  "name": "glimpse-browser",
  "version": "1.0.0",
  "description": "Glimpse Browser — A desktop browser with intelligent link prefetching",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "turbo run dev --filter=desktop",
    "dev:api": "turbo run dev --filter=cloud-api",
    "build:desktop": "turbo run build --filter=desktop",
    "build:win": "turbo run build:win --filter=desktop",
    "install:all": "npm install --workspaces",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "rimraf": "6.0.1",
    "turbo": "^2.11.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@10.8.0",
  "dependencies": {
    "electron": "44.4.2",
    "morgan": "1.12.1",
    "uuid": "14.0.2"
  }
}
