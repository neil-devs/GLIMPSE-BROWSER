# ============================================================================
# Glimpse Browser — Root Environment Variables
# ============================================================================
# This file documents ALL environment variables used across the monorepo.
# Individual apps have their own .env.example files with app-specific vars.
#
# Copy this to .env for root-level tooling only.
# For app-specific config, copy apps/cloud-api/.env.example and
# apps/desktop/.env.example to their respective .env files.
# ============================================================================

# ── General ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Cloud API (see apps/cloud-api/.env.example for full list) ───────────────
# PORT=3001
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# SUPABASE_ANON_KEY=
# JWT_SECRET=
# JWT_REFRESH_SECRET=
# ADMIN_API_KEY=your-secret-admin-key-here # Protects /admin/* endpoints (timingSafeEqual)
# ML_MIN_CLICKED_SEARCHES=300              # Minimum clicked searches required before retraining
# ML_RETRAIN_MIN_NEW=500                   # Minimum new clicked searches to trigger daily retrain

# ── Desktop (see apps/desktop/.env.example for full list) ───────────────────
# GLIMPSE_API_URL=http://localhost:3001
# TELEMETRY_ENABLED=true                   # Set to false to completely disable all telemetry collection
# GLIMPSE_TELEMETRY_DEBUG=0                # Set to 1 to print telemetry payloads instead of sending
# GLIMPSE_BENCH=0                          # Set to 1 when running prefetch benchmark suites
# PREFETCH_PRECONNECT_ALL=true             # Eagerly preconnect to all visible domains
# PREFETCH_HOVER_BOOST=true                # Prioritize link on >80ms cursor hover
# PREFETCH_STAGED_CONCURRENCY=2            # Max parallel page loads in flight
# PREFETCH_READY_MODE=usable               # 'usable' (DOM ready) or 'load' (window load)
# PREFETCH_POOL_SIZE=6                     # Pool capacity (3, 6, or 12)
# PREFETCH_THROTTLE_AFTER_READY=true       # Throttle pooled views once ready to save CPU
