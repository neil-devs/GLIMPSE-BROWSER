# ============================================================================
# Glimpse Browser — Root Environment Variables
# ============================================================================
# This file documents ALL environment variables used across the monorepo.
# Individual apps have their own .env.example files with app-specific vars.
#
# Copy this to .env for root-level tooling only.
# For app-specific config, copy apps/cloud-api/.env.example and
# apps/desktop/.env.example to their respective .env files.
# ============================================================================

# ── General ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Cloud API (see apps/cloud-api/.env.example for full list) ───────────────
# PORT=3001
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# SUPABASE_ANON_KEY=
# JWT_SECRET=
# JWT_REFRESH_SECRET=

# ── Desktop (see apps/desktop/.env.example for full list) ───────────────────
# CLOUD_API_URL=http://localhost:3001/api/v1
# TELEMETRY_ENABLED=true
